   "source": [
    "# Find the maximum sum of consecutive elements\n",
    "arr=[10,20,30,40]\n",
    "length=len(arr)\n",
    "sum=0\n",
    "max_sum=0\n",
    "for i in range(length):\n",
    "    if i < length-1:\n",
    "        max_sum=arr[i]+arr[i+1]\n",
    "print(\"Maximum sum:\",max_sum)"
